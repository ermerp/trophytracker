/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "trophytracker",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-03",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,

	/**
	 * Frontend und API teilen sich einen Worker und damit eine Origin.
	 * Kein CORS, ein Deploy-Pfad, eine Access-Richtlinie.
	 *
	 * run_worker_first: /api/* erreicht immer den Worker. Alles andere wird
	 * zuerst gegen die Assets aufgeloest; unbekannte Pfade fallen auf
	 * index.html zurueck, damit das SPA-Routing im Frontend greift.
	 */
	"assets": {
		"directory": "./frontend/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},

	/**
	 * database_id ist ein Bezeichner, kein Zugangsdatum, und darf laut
	 * Abschnitt 15.1 der Spezifikation im oeffentlichen Repo stehen.
	 * Anlegen mit: npx wrangler d1 create trophytracker
	 */
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "trophytracker",
			"database_id": "PLATZHALTER_AUS_WRANGLER_D1_CREATE"
		}
	]
}
